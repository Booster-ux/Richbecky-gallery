# Richbecky Gallery — Environment Variables Template

# Frontend Client Public Variables (Exposed to browser)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_public_key

# Backend Privileged Service Keys (Server-side ONLY - Never expose with VITE_ prefix)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
